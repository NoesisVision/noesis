{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "jsPlugins": [
    { "name": "boundaries", "specifier": "eslint-plugin-boundaries" }
  ],
  "categories": { "correctness": "error" },
  // Type-aware rules (no-floating-promises, …) run on tsgolint, which is
  // built on TypeScript 7's own compiler.
  "options": { "typeAware": true },
  "ignorePatterns": [
    "server/frontend/src/routeTree.gen.ts",
    "docs/**/prior-art/**",
    "docs/**/prototypes/**"
  ],
  "settings": {
    // The backend's layers (decision D3). A file belongs to the first
    // element whose folder contains it; `root` catches what is directly in
    // `src/` — the composition root.
    "boundaries/include": [
      "server/backend/src/**/*.ts",
      "server/frontend/src/**/*.ts",
      "server/frontend/src/**/*.tsx"
    ],
    "boundaries/elements": [
      {
        "type": "contracts",
        "pattern": "server/backend/src/app/*/model/**",
        "partialMatch": false
      },
      {
        "type": "platform",
        "pattern": "server/backend/src/platform/**",
        "partialMatch": false
      },
      {
        "type": "app",
        "pattern": "server/backend/src/app/**",
        "partialMatch": false
      },
      {
        "type": "adapters",
        "pattern": "server/backend/src/adapters/**",
        "partialMatch": false
      },
      {
        "type": "ui",
        "pattern": "server/backend/src/ui/**",
        "partialMatch": false
      },
      { "type": "root", "pattern": "server/backend/src" },
      {
        "type": "feature-ui",
        "pattern": "server/frontend/src/features/*/ui/**",
        "capture": ["feature"],
        "partialMatch": false
      },
      {
        "type": "feature-api",
        "pattern": "server/frontend/src/features/*",
        "capture": ["feature"]
      },
      {
        "type": "fe-shell",
        "pattern": "server/frontend/src/shell/**",
        "partialMatch": false
      },
      {
        "type": "fe-shared",
        "pattern": "server/frontend/src/shared/**",
        "partialMatch": false
      },
      {
        "type": "fe-routes",
        "pattern": "server/frontend/src/routes/**",
        "partialMatch": false
      },
      { "type": "fe-root", "pattern": "server/frontend/src" }
    ],
    "import/resolver": {
      "oxc": { "tsconfig": { "configFile": "./server/backend/tsconfig.json" } }
    }
  },
  "rules": {
    "import/no-cycle": "error",
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/no-unknown-files": "error",
    "boundaries/dependencies": [
      "error",
      {
        "default": "disallow",
        // Also judge npm and node: imports, so contracts can be held to zod.
        "checkAllOrigins": true,
        "policies": [
          {
            "allow": { "to": { "module": { "origin": ["core", "external"] } } }
          },
          // Contracts are the domain model in app/<feature>/model/, and
          // declarative: zod and other contracts only, since the plugin
          // copies them verbatim (decision D4).
          {
            "from": { "element": { "type": "contracts" } },
            "disallow": {
              "to": { "module": { "origin": ["core", "external"] } }
            }
          },
          {
            "from": { "element": { "type": "contracts" } },
            "allow": {
              "to": { "module": { "origin": "external", "source": "zod" } }
            }
          },
          {
            "from": { "element": { "type": "contracts" } },
            "allow": { "to": { "element": { "type": "contracts" } } }
          },
          // platform is generic plumbing; it knows nothing of the layers above.
          {
            "from": { "element": { "type": "platform" } },
            "allow": {
              "to": {
                "element": { "type": ["platform"] }
              }
            }
          },
          // app is the core: it declares the ports it needs and adapters
          // implement them. Import the port, not platform.
          {
            "from": { "element": { "type": "app" } },
            "allow": {
              "to": { "element": { "type": ["app", "contracts"] } }
            }
          },
          {
            "from": { "element": { "type": "adapters" } },
            "allow": {
              "to": {
                "element": {
                  "type": ["adapters", "app", "platform", "contracts"]
                }
              }
            }
          },
          {
            "from": { "element": { "type": "ui" } },
            "allow": {
              "to": {
                "element": {
                  "type": ["ui", "app", "platform", "contracts"]
                }
              }
            }
          },
          // The frontend reads the backend's model and route types only.
          // `fe-root` is where the generated route tree sits, so anything
          // typed against routes imports it.
          {
            "from": {
              "element": {
                "type": [
                  "feature-api",
                  "feature-ui",
                  "fe-shell",
                  "fe-shared",
                  "fe-routes",
                  "fe-root"
                ]
              }
            },
            "allow": {
              "to": { "element": { "type": ["contracts", "root", "fe-root"] } }
            }
          },
          // shared is the kernel: the client, the design system, routing ids.
          {
            "from": { "element": { "type": "fe-shared" } },
            "allow": { "to": { "element": { "type": "fe-shared" } } }
          },
          // A feature's data access sees the kernel and its own module.
          {
            "from": { "element": { "type": "feature-api" } },
            "allow": {
              "to": {
                "element": [
                  { "type": "fe-shared" },
                  { "type": "feature-api" },
                  {
                    "type": "feature-ui",
                    "capture": { "feature": "{{from.feature}}" }
                  }
                ]
              }
            }
          },
          // A feature's components see the kernel, any feature's api, and
          // their own feature's components — never another feature's ui.
          {
            "from": { "element": { "type": "feature-ui" } },
            "allow": {
              "to": {
                "element": [
                  { "type": "fe-shared" },
                  { "type": "feature-api" },
                  {
                    "type": "feature-ui",
                    "capture": { "feature": "{{from.feature}}" }
                  }
                ]
              }
            }
          },
          // The shell composes features; no feature may look back at it.
          {
            "from": { "element": { "type": "fe-shell" } },
            "allow": {
              "to": {
                "element": {
                  "type": ["fe-shell", "fe-shared", "feature-api", "feature-ui"]
                }
              }
            }
          },
          // Route files are the wiring: they may reach anything.
          {
            "from": { "element": { "type": ["fe-routes", "fe-root"] } },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "fe-routes",
                    "fe-root",
                    "fe-shell",
                    "fe-shared",
                    "feature-api",
                    "feature-ui"
                  ]
                }
              }
            }
          },
          // Only the composition root wires everything; nothing imports it.
          {
            "from": { "element": { "type": "root" } },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "root",
                    "ui",
                    "adapters",
                    "app",
                    "platform",
                    "contracts"
                  ]
                }
              }
            }
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["server/backend/**"],
      "rules": { "typescript/no-floating-promises": "error" }
    },
    {
      "files": ["server/frontend/**"],
      "rules": {
        "react/only-export-components": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@mantine/*"],
                "message": "Import from #/shared/design-system instead. Mantine is private to the design system."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/frontend/src/routes/**"],
      "rules": {
        "react/only-export-components": [
          "error",
          { "allowExportNames": ["Route"] }
        ]
      }
    },
    {
      // A feature's own files are siblings, reached relatively; the `#/`
      // alias means crossing into another module, and only a feature's api
      // may be crossed into. `boundaries` states the same rule but cannot
      // compare captured values through oxlint's plugin bridge, so the
      // cross-feature case is enforced here.
      "files": ["server/frontend/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@mantine/*"],
                "message": "Import from #/shared/design-system instead. Mantine is private to the design system."
              },
              {
                "group": ["#/features/*/ui/**"],
                "message": "A feature's components are private to it: import its `*.api.ts` or `*.model.ts` instead, and its own files relatively."
              },
              {
                "group": ["#/shell/**"],
                "message": "Features must not depend on the shell; the shell composes them."
              }
            ]
          }
        ]
      }
    },
    {
      // The design system wraps Mantine, theme augmentation included.
      "files": ["server/frontend/src/shared/design-system/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // bun's typings declare `expect().rejects`/`.resolves` matchers as
      // non-thenables; type tests reference members and methods on purpose.
      "files": ["**/test/**"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/unbound-method": "off",
        "typescript/restrict-template-expressions": "off",
        "no-unused-expressions": "off"
      }
    }
  ]
}
