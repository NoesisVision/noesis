{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "jsPlugins": [
    { "name": "boundaries", "specifier": "eslint-plugin-boundaries" }
  ],
  "categories": { "correctness": "error" },
  // Type-aware rules (no-floating-promises, …) run on tsgolint, which is
  // built on TypeScript 7's own compiler.
  "options": { "typeAware": true },
  "ignorePatterns": [
    "server/frontend/src/routeTree.gen.ts",
    "docs/**/prior-art/**",
    "docs/**/prototypes/**"
  ],
  "settings": {
    "boundaries/include": [
      "server/backend/src/**/*.ts",
      "server/frontend/src/**/*.ts",
      "server/frontend/src/**/*.tsx"
    ],
    // A file belongs to the first element that matches it; backend `root`
    // catches `main.ts` and `boot/`, the composition root.
    "boundaries/elements": [
      {
        "type": "platform",
        "pattern": "server/backend/src/platform/**",
        "partialMatch": false
      },
      {
        "type": "app",
        "pattern": "server/backend/src/app/**",
        "partialMatch": false
      },
      {
        "type": "adapter-in",
        "pattern": "server/backend/src/adapters/in/*/**",
        "capture": ["adapter"],
        "partialMatch": false
      },
      {
        "type": "adapter-out",
        "pattern": "server/backend/src/adapters/out/*/**",
        "capture": ["adapter"],
        "partialMatch": false
      },
      { "type": "root", "pattern": "server/backend/src" },
      {
        "type": "feature-ui",
        "pattern": "server/frontend/src/features/*/ui/**",
        "capture": ["feature"],
        "partialMatch": false
      },
      {
        "type": "feature-api",
        "pattern": "server/frontend/src/features/*",
        "capture": ["feature"]
      },
      {
        "type": "fe-shell",
        "pattern": "server/frontend/src/shell/**",
        "partialMatch": false
      },
      {
        "type": "fe-shared",
        "pattern": "server/frontend/src/shared/**",
        "partialMatch": false
      },
      {
        "type": "fe-routes",
        "pattern": "server/frontend/src/routes/**",
        "partialMatch": false
      },
      { "type": "fe-root", "pattern": "server/frontend/src" }
    ],
    "import/resolver": {
      "oxc": { "tsconfig": { "configFile": "./server/backend/tsconfig.json" } }
    }
  },
  "rules": {
    "import/no-cycle": "error",
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/no-unknown-files": "error",
    "boundaries/dependencies": [
      "error",
      {
        "default": "disallow",
        "policies": [
          {
            "from": { "element": { "type": "platform" } },
            "allow": {
              "to": {
                "element": { "type": ["platform"] }
              }
            }
          },
          // app declares the ports it needs and adapters implement them.
          {
            "from": { "element": { "type": "app" } },
            "allow": {
              "to": { "element": { "type": ["app"] } }
            }
          },
          {
            "from": { "element": { "type": "adapter-in" } },
            "allow": {
              "to": {
                "element": [
                  { "type": ["app", "platform"] },
                  {
                    "type": "adapter-in",
                    "captured": {
                      "adapter": "{{ from.element.captured.adapter }}"
                    }
                  }
                ]
              }
            }
          },
          {
            "from": { "element": { "type": "adapter-out" } },
            "allow": {
              "to": {
                "element": [
                  { "type": ["app", "platform"] },
                  {
                    "type": "adapter-out",
                    "captured": {
                      "adapter": "{{ from.element.captured.adapter }}"
                    }
                  }
                ]
              }
            }
          },
          // The frontend reads the backend's model and route types only.
          // `fe-root` holds the generated route tree.
          {
            "from": {
              "element": {
                "type": [
                  "feature-api",
                  "feature-ui",
                  "fe-shell",
                  "fe-shared",
                  "fe-routes",
                  "fe-root"
                ]
              }
            },
            "allow": {
              "to": { "element": { "type": ["app", "root", "fe-root"] } }
            }
          },
          {
            "from": { "element": { "type": "fe-shared" } },
            "allow": { "to": { "element": { "type": "fe-shared" } } }
          },
          {
            "from": { "element": { "type": "feature-api" } },
            "allow": {
              "to": {
                "element": [
                  { "type": "fe-shared" },
                  { "type": "feature-api" },
                  {
                    "type": "feature-ui",
                    "captured": {
                      "feature": "{{ from.element.captured.feature }}"
                    }
                  }
                ]
              }
            }
          },
          {
            "from": { "element": { "type": "feature-ui" } },
            "allow": {
              "to": {
                "element": [
                  { "type": "fe-shared" },
                  { "type": "feature-api" },
                  {
                    "type": "feature-ui",
                    "captured": {
                      "feature": "{{ from.element.captured.feature }}"
                    }
                  }
                ]
              }
            }
          },
          {
            "from": { "element": { "type": "fe-shell" } },
            "allow": {
              "to": {
                "element": {
                  "type": ["fe-shell", "fe-shared", "feature-api", "feature-ui"]
                }
              }
            }
          },
          {
            "from": { "element": { "type": ["fe-routes", "fe-root"] } },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "fe-routes",
                    "fe-root",
                    "fe-shell",
                    "fe-shared",
                    "feature-api",
                    "feature-ui"
                  ]
                }
              }
            }
          },
          {
            "from": { "element": { "type": "root" } },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "root",
                    "adapter-in",
                    "adapter-out",
                    "app",
                    "platform"
                  ]
                }
              }
            }
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["server/backend/**"],
      "rules": { "typescript/no-floating-promises": "error" }
    },
    {
      "files": ["server/frontend/**"],
      "rules": {
        "react/only-export-components": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@mantine/*"],
                "message": "Import from #/shared/design-system instead. Mantine is private to the design system."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/frontend/src/routes/**"],
      "rules": {
        "react/only-export-components": [
          "error",
          { "allowExportNames": ["Route"] }
        ]
      }
    },
    {
      // The design system wraps Mantine, theme augmentation included.
      "files": ["server/frontend/src/shared/design-system/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // bun's typings declare `expect().rejects`/`.resolves` matchers as
      // non-thenables; type tests reference members and methods on purpose.
      "files": ["**/test/**"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/unbound-method": "off",
        "typescript/restrict-template-expressions": "off",
        "no-unused-expressions": "off"
      }
    }
  ]
}
