{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "server/frontend/src/routeTree.gen.ts",
    "docs/**/prior-art",
    "docs/**/prototypes",
    "docs/arch/*.html",
    ".agents/",
    "examples/*/",
    "code-parsers/dotnet/test/Noesis.Parser.Tests/golden/",
    "code-parsers/java/core/src/test/resources/golden/",
    "server/frontend/.design-sync/"
  ]
}
