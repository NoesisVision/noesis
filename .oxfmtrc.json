{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "server/frontend/src/routeTree.gen.ts",
    "docs/**/prior-art",
    "docs/**/prototypes",
    ".agents/",
    "examples/*/",
    "scanners/dotnet/test/Noesis.Scanner.Tests/golden/",
    "server/backend/test/fixtures/csharp/shop/code-model/",
    "server/frontend/.design-sync/"
  ]
}
