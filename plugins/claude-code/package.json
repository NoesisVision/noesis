{
  "name": "@noesis-vision/claude-code-plugin",
  "version": "0.1.0-beta.4",
  "private": false,
  "description": "Noesis Claude Code plugin — the Noesis service, the skills that drive it and the contracts an agent reads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoesisVision/noesis.git",
    "directory": "plugins/claude-code"
  },
  "files": [
    ".claude-plugin/plugin.json",
    ".mcp.json",
    "contracts",
    "skills",
    "server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run tools/stamp-plugin-version.ts",
    "build": "bun run tools/build-contracts.ts contracts && bun run tools/build-service.ts server",
    "prepack": "bun run build",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "bump": "bun run tools/bump-version.ts",
    "release:beta": "bun run tools/release-beta.ts",
    "publish:beta": "bun publish --tag beta",
    "prepublishOnly": "bun run generate"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
