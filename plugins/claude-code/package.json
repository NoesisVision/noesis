{
  "name": "@noesis-vision/claude-code-plugin",
  "version": "0.1.0-beta.3",
  "private": false,
  "description": "Noesis Claude Code plugin — skills for preparing and validating MCP tool payloads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoesisVision/noesis.git",
    "directory": "plugins/claude-code"
  },
  "files": [
    ".claude-plugin/plugin.json",
    ".mcp.json",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run tools/generate-references.ts && bun run tools/stamp-plugin-version.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "bump": "bun run tools/bump-version.ts",
    "release:beta": "bun run tools/release-beta.ts",
    "publish:beta": "bun publish --tag beta",
    "prepublishOnly": "bun run generate"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@repo/mcp-contracts": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
