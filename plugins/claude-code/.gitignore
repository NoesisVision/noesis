# The contract sources, copied in from server/backend/src/app/*/model/ by
# `bun run build` (also on `bun pm pack`) and shipped in the tarball. Only the
# README describing the directory is committed.
/contracts/*
!/contracts/README.md

# The built service, copied in from server/backend/dist/ by `bun run build`
# (also on `bun pm pack`) and shipped in the tarball. Nothing in it is committed.
/server/
