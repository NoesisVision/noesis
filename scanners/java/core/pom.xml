<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vision.noesis</groupId>
    <artifactId>noesis-scanner-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>noesis-scanner-core</artifactId>
  <name>Noesis Scanner Core</name>
  <description>Build-tool-agnostic scanning engines: source roots and classpath in, code model files out</description>

  <dependencies>
    <dependency>
      <groupId>vision.noesis</groupId>
      <artifactId>noesis-scanner-model</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The fixture modules the golden tests scan; test-scoped so the reactor builds them first. -->
    <dependency>
      <groupId>vision.noesis.fixtures</groupId>
      <artifactId>java-syntax</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>vision.noesis.fixtures</groupId>
      <artifactId>java-syntax-other</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Exposes each dependency's path as ${groupId:artifactId:jar}, so the tests hand the engines the same classpath Maven resolved. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <noesis.repositoryRoot>${project.basedir}/../../..</noesis.repositoryRoot>
            <noesis.fixturesDir>${project.basedir}/../test-fixtures</noesis.fixturesDir>
            <noesis.schemaDir>${project.basedir}/../../code-model</noesis.schemaDir>
            <noesis.classpath.annotations>${vision.noesis:noesis-annotations:jar}</noesis.classpath.annotations>
            <noesis.classpath.guava>${com.google.guava:guava:jar}</noesis.classpath.guava>
            <noesis.classpath.other>${vision.noesis.fixtures:java-syntax-other:jar}</noesis.classpath.other>
            <noesis.version.guava>${guava.version}</noesis.version.guava>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
