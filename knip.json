{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // .design-sync/ holds the Claude Design sync inputs: previews import a
  // stand-in package only the converter resolves, and overrides/ is a
  // vendored copy of the converter's own code.
  "ignore": ["server/frontend/.design-sync/**"],
  // `bun check` (the type checker) and `bun fmt` (the formatter) are Bun
  // subcommands knip does not know, so it reads `check` and `fmt` in the
  // scripts as binaries nothing installs.
  "ignoreBinaries": ["check", "fmt"],
  "workspaces": {
    ".": {
      // Skill scripts are run by the agent, never imported.
      "entry": [".agents/skills/*/scripts/*.ts"]
    },
    "server/backend": {
      // Type-only tests are checked by bun check and never imported; the fake
      // code model tools are spawned by specs, never imported. The design
      // document, its element ids and design doc fields, the system model
      // and the code model are exported whole: a type nothing imports yet is
      // still part of the domain model.
      "entry": [
        "src/main.ts",
        "src/app/design-docs/design-doc.ts",
        "src/app/element-id.ts",
        "src/app/design-docs/design-doc-field.ts",
        "src/app/system-model/system-model.ts",
        "src/app/scanners/code-parsers/code-model.ts",
        "test/**/*.types.ts",
        "test/support/fake-code-model-tool.ts",
        "test/support/fake-parse-csharp.ts"
      ]
    },
    "server/frontend": {
      "entry": ["test/**/*.types.ts"]
    }
  }
}
