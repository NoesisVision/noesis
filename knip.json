{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Prototypes and prior art under docs/ are reference material, not code
  // (Oxlint skips them too).
  "ignore": ["docs/**/prior-art/**", "docs/**/prototypes/**"],
  "workspaces": {
    "server/backend": {
      // Type-only tests are checked by tsc and never imported. The design
      // document, its element ids and design doc fields, and the system
      // model are exported whole: a type nothing imports yet is still part
      // of the domain model.
      "entry": [
        "src/main.ts",
        "src/app/changes/model/design-doc.ts",
        "src/app/element-id.ts",
        "src/app/changes/model/design-doc-field.ts",
        "src/app/system-model/system-model.ts",
        "test/**/*.types.ts"
      ]
    },
    "server/mcp": {
      // Reached from the backend's bin, which bundles it.
      "entry": ["src/attach.ts"]
    },
    "server/frontend": {
      "entry": ["test/**/*.types.ts"]
    }
  }
}
