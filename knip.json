{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "server/backend": {
      // Type-only tests are checked by tsc and never imported. The design
      // document, its element ids and reviewable fields, and the system
      // model are exported whole: a type nothing imports yet is still part
      // of the domain model.
      "entry": [
        "src/main.ts",
        "src/app/design-docs/design-doc.ts",
        "src/app/element-id.ts",
        "src/app/design-docs/reviewable-field.ts",
        "src/app/system-model/system-model.ts",
        "test/**/*.types.ts"
      ]
    },
    "server/frontend": {
      "entry": ["test/**/*.types.ts"]
    },
    "plugins/claude-code": {
      // Never imported: the workspace dependency orders `bun run --filter`
      // so the service's pack test finishes building dist before the
      // plugin's tarball test rebuilds it.
      "ignoreDependencies": ["@noesis-vision/noesis"]
    }
  }
}
