{
  "name": "noesis",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:openssl": "brew install openssl@3",
    "build": "bun run --filter '*' build",
    "build:plugin": "bun run --cwd plugins/claude-code build",
    "dev": "bun run server/scripts/dev.ts",
    "start:debug": "bun run --cwd server/backend start:debug",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '*' test:e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "bun run lint:fix && bun run format && knip --fix",
    "check-types": "tsc --noEmit && bun run --filter '*' check-types",
    "generate": "bun run --filter '*' generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "ci": "bun run lint && bun run knip && bun run format:check && bun run check-types && bun run test && bun run test:e2e && bun run build"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eslint-import-resolver-oxc": "^0.15.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "knip": "^6.37.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "server/*",
      "plugins/*"
    ],
    "catalog": {
      "@types/bun": "^1.2.0",
      "@types/node": "^24.13.2",
      "hono": "^4.12.28",
      "typescript": "^7.0.2",
      "zod": "^4.2.0"
    }
  }
}
