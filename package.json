{
  "name": "noesis",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:openssl": "brew install openssl@3",
    "build": "bun run --filter '*' build",
    "build:plugin": "bun run --cwd plugins/claude-code build",
    "dev": "bun run server/scripts/dev.ts",
    "start:debug": "bun run --cwd server/backend start:debug",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\"",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '*' test:e2e",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "check-types": "tsc --noEmit && bun run --filter '*' check-types",
    "generate": "bun run --filter '*' generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "ci": "bun run lint && bun run lint:md && bun run check-types && bun run test && bun run test:e2e && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "server/*",
      "plugins/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.8",
      "@types/bun": "^1.2.0",
      "@types/node": "^24.13.2",
      "hono": "^4.12.28",
      "prettier": "^3.9.6",
      "typescript": "^7.0.2",
      "zod": "^4.1.0"
    }
  }
}
