{
  "name": "noesis-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=server --filter=ui",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins/*"
    ],
    "catalog": {
      "@types/node": "^24.0.0",
      "eslint": "^9.39.1",
      "prettier": "^3.7.4",
      "typescript": "5.9.2"
    }
  }
}
