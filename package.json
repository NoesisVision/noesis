{
  "name": "noesis",
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "dev:server": "./scripts/dev-server.sh",
    "dev:local": "NOESIS_AUTH_MODE=local NOESIS_DATA_DIR=.data-local ./scripts/dev-server.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\"",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '*' test:e2e",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "check-types": "bun run --filter '*' check-types",
    "generate": "bun run --filter '*' generate",
    "prepare": "git config core.hooksPath .githooks || true",
    "ci": "bun run lint && bun run lint:md && bun run check-types && bun run test && bun run test:e2e && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "prettier": "^3.9.6",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": [
      "server/*",
      "packages/*",
      "plugins/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.8",
      "@types/bun": "^1.2.0",
      "@types/node": "^24.13.2",
      "hono": "^4.12.28",
      "prettier": "^3.9.6",
      "typescript": "^7.0.2",
      "zod": "^4.1.0"
    }
  }
}
