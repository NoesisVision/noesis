{
  "name": "noesis",
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter=server --filter=ui dev",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '*' test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "bun run --filter '*' check-types",
    "generate": "bun run --filter '*' generate",
    "ci": "bun run lint && bun run check-types && bun run test && bun run test:e2e && bun run build"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins/*"
    ],
    "catalog": {
      "@types/bun": "^1.2.0",
      "@types/node": "^24.0.0",
      "eslint": "^9.39.1",
      "prettier": "^3.7.4",
      "typescript": "5.9.2"
    }
  }
}
