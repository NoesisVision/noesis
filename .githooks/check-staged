#!/bin/sh
# Fast checks on staged files only (mirrors CI's format + lint jobs). Not a git
# hook itself: commit-msg runs it, because only there is the message known and
# a WIP commit can skip it. A pre-commit hook runs before the message exists.
set -e

# Hooks inherit the environment of whatever launched git, and a GUI client or an
# IDE (notably the Flatpak VS Code, whose sandbox PATH is just /app/bin) never
# sources the shell rc that puts bun on PATH. Fall back to bun's install dir.
if ! command -v bunx >/dev/null 2>&1; then
  PATH="${BUN_INSTALL:-$HOME/.bun}/bin:$PATH"
  export PATH
fi

if ! command -v bunx >/dev/null 2>&1; then
  echo "check-staged: bunx not found on PATH." >&2
  echo "  Install bun (https://bun.sh) or set BUN_INSTALL to its install dir." >&2
  echo "  Skip these checks for one commit with a 'wip' subject or: git commit -n" >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Both tools skip what they ignore or cannot handle (a lockfile, an image), so
# the whole list goes to each. They read the working tree, not the index.
# Oxlint's layer and cycle rules resolve imports across the project, so a
# staged file is judged against everything it imports.
echo "$staged" | tr '\n' '\0' | xargs -0 bunx oxfmt --check --no-error-on-unmatched-pattern
echo "$staged" | tr '\n' '\0' | xargs -0 bunx oxlint --no-error-on-unmatched-pattern
