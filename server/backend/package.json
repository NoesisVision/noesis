{
  "name": "@noesis-vision/noesis",
  "version": "0.1.0-beta.4",
  "description": "Noesis service — one stdio MCP process per agent session, serving the knowledge graph in .noesis/ and the browser UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoesisVision/noesis.git",
    "directory": "server/backend"
  },
  "type": "module",
  "bin": {
    "noesis": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_ENV=production bun build src/main.ts --outdir dist --target bun --production --external @ladybugdb/core --banner '#!/usr/bin/env bun' --entry-naming '[name].[ext]' --public-path /",
    "start": "bun dist/main.js",
    "dev": "PORT=3001 NOESIS_OPEN_BROWSER=0 bun --watch src/main.ts",
    "start:debug": "PORT=3000 NOESIS_OPEN_BROWSER=0 bun --inspect --watch src/main.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test test/unit test/integration",
    "test:e2e": "bun test test/e2e",
    "test:bench": "bun test test/bench",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.19.0"
  },
  "trustedDependencies": [
    "@ladybugdb/core"
  ],
  "devDependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@logtape/file": "^2.3.4",
    "@logtape/hono": "^2.3.4",
    "@logtape/logtape": "^2.3.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
