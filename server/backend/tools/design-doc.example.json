{
  "name": {
    "value": "Partial refunds for orders",
    "status": "acceptedByHuman"
  },
  "description": {
    "value": "Lets support refund individual order lines instead of the whole order, and retires the legacy credit note flow.",
    "status": "setByAgent"
  },
  "modules": {
    "added": [
      {
        "id": "module|sales.refunds",
        "description": {
          "value": "Everything about giving money back to a customer.",
          "status": "setByAgent"
        }
      }
    ],
    "removed": ["module|sales.credit-notes"],
    "modified": [
      {
        "id": "module|sales.orders",
        "description": {
          "value": "Order lifecycle, now including the refundable state of each line.",
          "status": "acceptedByHuman"
        }
      }
    ]
  },
  "buildingBlocks": {
    "added": [
      {
        "id": "building_block|sales.refunds.Refund",
        "type": { "value": "aggregate", "status": "acceptedByHuman" },
        "description": {
          "value": "A refund of one or more lines of a single order.",
          "status": "setByAgent"
        },
        "properties": {
          "added": [
            {
              "name": { "value": "orderId", "status": "acceptedByHuman" },
              "type": { "value": "OrderId", "status": "setByAgent" },
              "description": {
                "value": "The order the refunded lines belong to.",
                "status": "setByAgent"
              }
            },
            {
              "name": { "value": "lines", "status": "setByAgent" },
              "type": { "value": "RefundLine", "status": "setByAgent" },
              "collection": true
            },
            {
              "name": { "value": "issuedAt", "status": "setByAgent" },
              "type": { "value": "Date", "status": "setByAgent" },
              "nullable": true
            }
          ]
        },
        "rules": {
          "added": [
            {
              "name": {
                "value": "Refund never exceeds paid amount",
                "status": "acceptedByHuman"
              },
              "ruleType": "Consistency",
              "description": {
                "value": "The sum of all refunds of an order is at most what the customer paid for it.",
                "status": "acceptedByHuman"
              }
            }
          ]
        },
        "scenarios": {
          "added": [
            {
              "name": {
                "value": "Refunding one line of a paid order",
                "status": "setByAgent"
              },
              "description": {
                "value": "The happy path of a partial refund.",
                "status": "setByAgent"
              },
              "given": {
                "value": "a paid order with two lines",
                "status": "setByAgent"
              },
              "when": {
                "value": "support refunds the first line",
                "status": "setByAgent"
              },
              "then": {
                "value": "a refund for that line's amount is issued and the second line stays refundable",
                "status": "setByAgent"
              }
            }
          ]
        }
      },
      {
        "id": "building_block|sales.refunds.RefundIssued",
        "type": { "value": "domain_event", "status": "setByAgent" }
      },
      {
        "id": "building_block|sales.refunds.RefundRepository",
        "type": { "value": "repository", "status": "setByAgent" },
        "implements": ["building_block|sales.shared.Repository"]
      }
    ],
    "removed": ["building_block|sales.credit-notes.CreditNote"],
    "modified": [
      {
        "id": "building_block|sales.orders.Order",
        "properties": {
          "added": [
            {
              "name": { "value": "refundedAmount", "status": "setByAgent" },
              "type": { "value": "Money", "status": "setByAgent" }
            }
          ],
          "removed": ["creditNoteId"],
          "modified": [
            {
              "name": { "value": "status", "status": "acceptedByHuman" },
              "type": { "value": "OrderStatus", "status": "acceptedByHuman" },
              "description": {
                "value": "Gains the 'partially_refunded' state.",
                "status": "setByAgent"
              }
            }
          ]
        }
      }
    ]
  },
  "behaviours": {
    "added": [
      {
        "id": "behavior|sales.refunds.Refund.issue",
        "type": { "value": "Command", "status": "acceptedByHuman" },
        "description": {
          "value": "Issues a refund for the chosen lines of an order.",
          "status": "setByAgent"
        },
        "input": { "added": ["OrderId", "RefundLine[]"] },
        "output": { "added": ["RefundIssued"] },
        "usedBuildingBlocks": {
          "added": [
            "building_block|sales.orders.Order",
            "building_block|sales.refunds.RefundRepository"
          ]
        },
        "rules": {
          "added": [
            {
              "name": {
                "value": "Only paid orders are refundable",
                "status": "setByAgent"
              },
              "ruleType": "State change"
            }
          ]
        },
        "isPublic": true,
        "actor": { "value": "Support agent", "status": "acceptedByHuman" }
      }
    ],
    "removed": ["behavior|sales.credit-notes.CreditNote.issue"],
    "modified": [
      {
        "id": "behavior|sales.orders.Order.cancel",
        "usedBuildingBlocks": {
          "added": ["building_block|sales.refunds.Refund"],
          "removed": ["building_block|sales.credit-notes.CreditNote"]
        }
      }
    ]
  },
  "implemented": false
}
