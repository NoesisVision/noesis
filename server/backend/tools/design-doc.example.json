                "value": "Why support refunds the lines."
              },
              "optional": {
                "value": true
              }
            }
          ]
        },
        "output": {
          "added": [
            {
              "type": "building_block|sales.refunds.RefundIssued",
              "description": {
                "value": "Tells the ledger the refund went out."
              },
              "optional": {
                "value": false
              }
            }
          ]
        },
        "rules": {
          "added": [
            {
              "name": "Only paid orders are refundable",
              "category": {
                "value": "Business"
              },
              "ruleType": {
                "value": "State change"
              },
              "description": {
                "value": "An unpaid order has nothing to refund."
              },
              "needs": {
                "value": []
              }
            }
          ]
        }
      }
    ],
    "removed": ["behavior|sales.credit-notes.CreditNote.issue"],
    "modified": [
