        "id": "building_block|sales.refunds.Refund",
        "name": {
          "value": "Refund",
          "author": "human"
        },
        "type": {
          "value": "aggregate",
          "author": "human"
        },
        "definition": {
          "value": "A refund of one or more lines of a single order."
        },
        "properties": {
          "added": [
            {
              "name": "orderId",
              "type": {
                "value": "building_block|sales.orders.OrderId",
                "author": "human"
              },
              "description": {
                "value": "The order the refunded lines belong to."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "lines",
              "type": {
                "value": {
                  "collectionOf": "building_block|sales.refunds.RefundLine"
                }
              },
              "description": {
                "value": "The refunded lines."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "notes",
              "type": {
                "value": {
                  "collectionOf": {
                    "collectionOf": "primitive|string"
                  }
                }
              },
              "description": {
                "value": "Notes per line, several per line."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "issuedAt",
              "type": {
                "value": "primitive|datetime"
              },
              "description": {
                "value": "When the refund was issued."
              },
              "optional": {
                "value": true
              }
            }
          ]
        },
        "rules": {
          "added": [
            {
              "name": "Refund never exceeds paid amount",
              "category": {
                "value": "Business"
              },
              "ruleType": {
                "value": "Consistency"
              },
              "description": {
                "value": "The sum of all refunds of an order is at most what the customer paid for it.",
                "author": "human"
              },
              "needs": {
                "value": ["refund-single-lines"]
              },
              "rationale": {
                "value": "Support may never pay out more than the order brought in."
              }
            }
          ]
        },
        "scenarios": {
          "added": [
            {
              "name": "Refunding one line of a paid order",
              "description": {
                "value": "The happy path of a partial refund."
              },
              "given": {
                "value": "a paid order with two lines"
              },
              "when": {
                "value": "support refunds the first line"
              },
              "then": {
                "value": "a refund for that line's amount is issued and the second line stays refundable"
              }
            }
          ]
        }
      },
      {
        "id": "building_block|sales.refunds.RefundIssued",
        "name": {
          "value": "RefundIssued"
        },
        "type": {
          "value": "value_object"
        },
        "definition": {
