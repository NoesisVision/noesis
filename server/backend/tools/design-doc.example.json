{
  "name": "Partial refunds for orders",
  "description": "Lets support refund individual order lines instead of the whole order, and retires the legacy credit note flow.",
  "modules": {
    "added": [
      {
        "id": "module|sales.refunds",
        "name": {
          "value": "refunds"
        },
        "description": {
          "value": "Everything about giving money back to a customer."
        }
      }
    ],
    "removed": ["module|sales.credit-notes"],
    "modified": [
      {
        "id": "module|sales.orders",
        "description": {
          "value": "Order lifecycle, now including the refundable state of each line.",
          "author": "human"
        }
      }
    ]
  },
  "buildingBlocks": {
    "added": [
      {
        "id": "building_block|sales.refunds.Refund",
        "name": {
          "value": "Refund",
          "author": "human"
        },
        "type": {
          "value": "aggregate",
          "author": "human"
        },
        "description": {
          "value": "A refund of one or more lines of a single order."
        },
        "properties": {
          "added": [
            {
              "name": "orderId",
              "type": {
                "value": "building_block|sales.orders.OrderId",
                "author": "human"
              },
              "description": {
                "value": "The order the refunded lines belong to."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "lines",
              "type": {
                "value": {
                  "collectionOf": "building_block|sales.refunds.RefundLine"
                }
              },
              "description": {
                "value": "The refunded lines."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "notes",
              "type": {
                "value": {
                  "collectionOf": {
                    "collectionOf": {
                      "primitive": "string"
                    }
                  }
                }
              },
              "description": {
                "value": "Notes per line, several per line."
              },
              "optional": {
                "value": false
              }
            },
            {
              "name": "issuedAt",
              "type": {
                "value": {
                  "primitive": "datetime"
                }
              },
              "description": {
                "value": "When the refund was issued."
              },
              "optional": {
                "value": true
              }
            }
          ]
        },
        "rules": {
          "added": [
            {
              "name": "Refund never exceeds paid amount",
              "ruleType": {
                "value": "Consistency"
              },
              "description": {
                "value": "The sum of all refunds of an order is at most what the customer paid for it.",
                "author": "human"
              }
            }
          ]
        },
        "scenarios": {
          "added": [
            {
              "name": "Refunding one line of a paid order",
              "description": {
                "value": "The happy path of a partial refund."
              },
              "given": {
                "value": "a paid order with two lines"
              },
              "when": {
                "value": "support refunds the first line"
              },
              "then": {
                "value": "a refund for that line's amount is issued and the second line stays refundable"
              }
            }
          ]
        }
      },
      {
        "id": "building_block|sales.refunds.RefundIssued",
        "name": {
          "value": "RefundIssued"
        },
        "type": {
          "value": "domain_event"
        },
        "description": {
          "value": "Tells the ledger a refund went out."
        }
      },
      {
        "id": "building_block|sales.refunds.RefundRepository",
        "name": {
          "value": "RefundRepository"
        },
        "type": {
          "value": "repository"
        },
        "description": {
          "value": "Stores refunds."
        },
        "implements": {
          "added": ["building_block|sales.shared.Repository"]
        }
      }
    ],
    "removed": ["building_block|sales.credit-notes.CreditNote"],
    "modified": [
      {
        "id": "building_block|sales.orders.Order",
        "properties": {
          "added": [
            {
              "name": "refundedAmount",
              "type": {
                "value": "building_block|sales.shared.Money"
              },
              "description": {
                "value": "What has been refunded so far."
              },
              "optional": {
                "value": false
              }
            }
          ],
          "removed": ["creditNoteId"],
          "modified": [
            {
              "name": "status",
              "type": {
                "changed": false,
                "author": "human"
              },
              "description": {
                "value": "Gains the 'partially_refunded' state."
              }
            }
          ]
        }
      }
    ]
  },
  "behaviours": {
    "added": [
      {
        "id": "behavior|sales.refunds.Refund.issue",
        "name": {
          "value": "issue"
        },
        "type": {
          "value": "Command",
          "author": "human"
        },
        "description": {
          "value": "Issues a refund for the chosen lines of an order."
        },
        "visibility": {
          "value": {
            "kind": "public",
            "actors": ["Support agent"]
          },
          "author": "human"
        },
        "input": {
          "added": [
            "building_block|sales.orders.OrderId",
            {
              "collectionOf": "building_block|sales.refunds.RefundLine"
            },
            {
              "primitive": "string"
            }
          ]
        },
        "output": {
          "added": ["building_block|sales.refunds.RefundIssued"]
        },
        "usedBuildingBlocks": {
          "added": [
            "building_block|sales.orders.Order",
            "building_block|sales.refunds.RefundRepository"
          ]
        },
        "rules": {
          "added": [
            {
              "name": "Only paid orders are refundable",
              "ruleType": {
                "value": "State change"
              },
              "description": {
                "value": "An unpaid order has nothing to refund."
              }
            }
          ]
        }
      }
    ],
    "removed": ["behavior|sales.credit-notes.CreditNote.issue"],
    "modified": [
      {
        "id": "behavior|sales.orders.Order.cancel",
        "visibility": {
          "value": {
            "kind": "private"
          }
        },
        "usedBuildingBlocks": {
          "added": ["building_block|sales.refunds.Refund"],
          "removed": ["building_block|sales.credit-notes.CreditNote"]
        }
      }
    ]
  },
  "implemented": false
}
