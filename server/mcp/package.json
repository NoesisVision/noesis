{
  "name": "@noesis-vision/noesis-mcp",
  "private": true,
  "description": "The Noesis MCP server: the tools an agent session calls, on stdio. Bundled into the service's bin by server/backend.",
  "type": "module",
  "imports": {
    "#mcp/*": "./src/*",
    "#backend/*": "../backend/src/*",
    "#backend-test/*": "../backend/test/*"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:e2e": "bun test test/e2e"
  },
  "devDependencies": {
    "@logtape/logtape": "^2.3.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  }
}
