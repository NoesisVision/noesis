{
  // Browser code. Follows the create-vite react-ts template; no Bun or Node
  // types, so runtime-only APIs fail type-checking here. The Hono RPC client
  // type (#backend/app.types.ts) pulls backend source into this program, so
  // that source must stay runtime-neutral too (decision D5).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    // esnext.array: the backend services behind the route types use
    // Array.fromAsync.
    "lib": ["ES2023", "ESNext.Array", "DOM"],
    "module": "ESNext",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true
  },
  // Local declarations in src/types load through this include.
  "include": ["src"]
}
