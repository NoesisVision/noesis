{
  // One config per runtime, checked with `tsc -b` (create-vite layout).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.test.json" }
  ],
  // The aliases live here, not in tsconfig.app.json, because Bun's bundler
  // and test runner read paths from tsconfig.json and do not follow
  // references. tsconfig.app.json extends this file to share them.
  "compilerOptions": {
    "paths": {
      "#/server/*": ["../backend/src/*"],
      "#/*": ["./src/*"]
    }
  }
}
