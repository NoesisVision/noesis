        "scenarios": {
          "added": [
            {
              "name": "Weather API failure does not break discount calculation",
              "description": {
                "changed": true,
                "value": "Covers HTTP 500, a timeout and malformed JSON from the weather API; each must degrade to unknown weather.",
                "author": "agent"
              },
              "steps": {
                "changed": true,
                "value": [
                  {
                    "kind": "given",
                    "text": "the weather API responds with HTTP 500, or does not respond within the request timeout, or returns a body that is not valid JSON"
                  },
                  {
                    "kind": "when",
                    "text": "the current weather is requested"
                  },
                  {
                    "kind": "then",
                    "text": "the result is empty, no exception is thrown, and a subsequent discount calculation completes with no weather discount"
                  }
                ],
                "author": "agent"
              }
            },
            {
              "name": "Open-Meteo response is mapped to a weather snapshot",
              "description": {
                "changed": true,
                "value": "Integration test of the adapter against a local HTTP stub standing in for Open-Meteo.",
                "author": "agent"
              },
              "steps": {
                "changed": true,
                "value": [
                  {
                    "kind": "given",
                    "text": "a local HTTP stub answering {\"current\":{\"precipitation\":0.5}} and the adapter pointed at that stub"
                  },
                  {
                    "kind": "when",
                    "text": "the current weather is requested"
                  },
                  {
                    "kind": "then",
                    "text": "the result is a Weather with precipitation 0.5"
                  }
                ],
                "author": "agent"
              }
            }
          ],
