{
  "parser": {
    "language": "java",
    "command": [
      "./gradlew",
      "-q",
      "noesisParse",
      "-Pnoesis.out={out}",
      "-Pnoesis.repositoryRoot={root}",
      "-Pnoesis.repository={name}"
    ],
    "installHint": "Run the service on a JDK 17 or newer; the build takes the vision.noesis.parser plugin from Maven Central."
  },
  "namespacePartsToSkip": ["com.itlibrium"],
  "namespacesToExclude": []
}
