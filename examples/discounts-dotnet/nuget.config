<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- nuget.org alone: every package the example uses is published there,
         and a private feed fails the whole restore wherever it cannot be
         reached, as on CI, leaving the scanner no attributes to read. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
