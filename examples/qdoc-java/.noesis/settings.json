{
  "parser": {
    "language": "java",
    "command": [
      "./mvnw",
      "-B",
      "-q",
      "-ntp",
      "-Dnoesis.out={out}",
      "-Dnoesis.repository={name}",
      "-Dmaven.compiler.failOnError=false",
      "process-classes",
      "noesis:parse"
    ],
    "installHint": "Run the service on a JDK 17 or newer; the build takes noesis-parser-maven-plugin from Maven Central."
  },
  "namespacePartsToSkip": ["com.example"],
  "namespacesToExclude": []
}
